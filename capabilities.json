    {
      "id": "provider-adapters",
      "name": "Provider adapters",
      "runtime_type": "adapter",
      "scope": "global",
      "providers": "Codex / Claude",
      "load_strategy": "lazy",
      "status": "merge",
      "reason": "Generate format-only pointers to canonical instructions; never copy vendor caches.",
      "sources": [
        "bin/ai-team"
      ]
    }
  ]
}
