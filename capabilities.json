{
  "schema_version": 1,
  "policy": "POLICY.md",
  "routing": "routing.json",
  "max_conditional_workflows": 2,
  "runtime_roots": [
    "roles",
    "workflows",
    "skills/graphify"
  ],
  "excluded_runtime_roots": [
    "backup-2026-09-29",
    "docs",
    "state",
    "provider caches",
    "vendor plugins",
    "project facts"
  ],
  "capabilities": [
    {
      "id": "runtime-controls",
      "name": "Deterministic orchestration controls",
      "runtime_type": "script",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "always",
      "status": "replace",
      "reason": "Triage, budgeting, verification, mapping, routing and cost estimation stay in existing code; no prompt copies.",
      "sources": [
        "bin/ai-team",
        "scripts/bootstrap.py",
        "scripts/manage.py",
        "routing.json",
        "POLICY.md"
      ]
    },
    {
      "id": "orchestration",
      "name": "Orchestration",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "keep",
      "reason": "One lead workflow; current policy and routing remain authoritative.",
      "sources": [
        "roles/orchestrator.md"
      ]
    },
    {
      "id": "exploration",
      "name": "Targeted exploration",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "keep",
      "reason": "Read only evidence needed for the next action; no ecosystem discovery.",
      "sources": [
        "roles/explorer.md"
      ]
    },
    {
      "id": "implementation",
      "name": "Implementation",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "keep",
      "reason": "Bounded changes from established evidence.",
      "sources": [
        "roles/implementer.md"
      ]
    },
    {
      "id": "debugging",
      "name": "Debugging / test repair",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "merge",
      "reason": "One root-cause workflow, including test failure diagnosis; selected existing roles only.",
      "sources": [
        "workflows/debugging.md"
      ],
      "roles": [
        "explorer",
        "implementer"
      ],
      "task_pattern": "\\b(debug|bug|error|fail\\w*|crash\\w*|broken|regression|flaky|root cause|test repair)\\b|\u043e\u0448\u0438\u0431\u043a|\u0431\u0430\u0433|\u043f\u0430\u0434\u0430|\u043f\u043e\u0447\u0438\u043d"
    },
    {
      "id": "architecture",
      "name": "Architecture",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "keep",
      "reason": "Existing architect decides only unresolved cross-module choices.",
      "sources": [
        "roles/architect.md"
      ]
    },
    {
      "id": "review",
      "name": "Review / disagreement resolution",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "merge",
      "reason": "One reviewer plus conditional judge; retain existing risk gates.",
      "sources": [
        "roles/reviewer.md",
        "roles/judge.md"
      ]
    },
    {
      "id": "research",
      "name": "Research",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "lazy",
      "status": "keep",
      "reason": "External facts with exact versions and official sources when needed.",
      "sources": [
        "roles/researcher.md"
      ]
    },
    {
      "id": "dependencies",
      "name": "Dependency investigation",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "merge",
      "reason": "Relevant manifest/lockfile/caller evidence; no separate agent or package installation.",
      "sources": [
        "workflows/dependencies.md"
      ],
      "roles": [
        "explorer",
        "researcher",
        "implementer"
      ],
      "task_pattern": "\\b(dependenc\\w*|package|lockfile|peer|upgrade|version)\\b|\u0437\u0430\u0432\u0438\u0441\u0438\u043c|\u043e\u0431\u043d\u043e\u0432\u0438"
    },
    {
      "id": "migration",
      "name": "Migration planning",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "merge",
      "reason": "Phases, compatibility, checks and recovery augment existing roles.",
      "sources": [
        "workflows/migration.md"
      ],
      "roles": [
        "architect",
        "researcher",
        "implementer"
      ],
      "task_pattern": "\\b(migrat\\w*|schema change|rollback)\\b|\u043c\u0438\u0433\u0440\u0430\u0446"
    },
    {
      "id": "security",
