      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "keep",
      "reason": "Existing make_handoff and role output schemas; protocol is a reference, not repeated prompt content.",
      "sources": [
        "bin/ai-team",
