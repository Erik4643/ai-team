      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "merge",
      "reason": "Evidence-based trust-boundary review; no always-on external scanner.",
      "sources": [
        "workflows/security.md"
      ],
      "roles": [
        "reviewer",
        "architect"
      ],
      "task_pattern": "\\b(auth\\w*|security|permission\\w*|secret\\w*|credential\\w*|payment\\w*|injection|xss|csrf)\\b|\u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d|\u0430\u0432\u0442\u043e\u0440\u0438\u0437"
    },
    {
      "id": "performance",
      "name": "Performance investigation",
      "runtime_type": "role",
      "scope": "global",
      "providers": "shared",
      "load_strategy": "conditional",
      "status": "merge",
      "reason": "Measure and profile before changing a hot path; use existing roles.",
      "sources": [
        "workflows/performance.md"
      ],
      "roles": [
        "explorer",
        "implementer",
        "architect"
      ],
      "task_pattern": "\\b(performance|profil\\w*|latency|slow|throughput|leak\\w*|allocation|contention|hot path)\\b|\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442\u0435\u043b\u044c\u043d|\u0443\u0442\u0435\u0447\u043a"
    },
    {
      "id": "handoff",
